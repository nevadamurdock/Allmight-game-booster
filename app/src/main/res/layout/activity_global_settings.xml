<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graphite_90"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_md">

            <!-- Section: Umum -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UMUM"
                android:textColor="@color/steel_40"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/graphite_70"
                android:orientation="vertical">

                <!-- Battery threshold -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/panel_padding">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Auto revert baterai"
                            android:textColor="@color/paper_05"
                            android:textSize="@dimen/text_body" />
                        <TextView
                            android:id="@+id/tvBatteryThreshold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:textColor="@color/copper_signal"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                    <SeekBar
                        android:id="@+id/seekBatteryThreshold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm"
                        android:max="50"
                        android:progress="10"
                        android:progressTint="@color/copper_signal"
                        android:thumbTint="@color/copper_signal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/graphite_50" />

                <!-- Default preset -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/panel_padding">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Preset default app baru"
                            android:textColor="@color/paper_05"
                            android:textSize="@dimen/text_body" />
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/rgDefaultPreset"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_sm">
                        <RadioButton
                            android:id="@+id/rbPerformance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preset_performance"
                            android:textColor="@color/paper_05"
                            android:buttonTint="@color/copper_signal" />
                        <RadioButton
                            android:id="@+id/rbBalanced"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preset_balanced"
                            android:textColor="@color/paper_05"
                            android:buttonTint="@color/copper_signal" />
                        <RadioButton
                            android:id="@+id/rbBatterySaver"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/preset_battery_saver"
                            android:textColor="@color/paper_05"
                            android:buttonTint="@color/copper_signal" />
                    </RadioGroup>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_lg" />

            <!-- Section: Izin & Info -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IZIN &amp; INFO"
                android:textColor="@color/steel_40"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/graphite_70"
                android:orientation="vertical">

                <!-- Kelola izin -->
                <LinearLayout
                    android:id="@+id/btnManagePermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/panel_padding"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?android:attr/selectableItemBackground">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Kelola izin"
                        android:textColor="@color/paper_05"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="›"
                        android:textColor="@color/steel_40"
                        android:textSize="18sp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/graphite_50" />

                <!-- Module status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/panel_padding">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status modul"
                        android:textColor="@color/paper_05"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:id="@+id/tvModuleStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/steel_40"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/graphite_50" />

                <!-- Version -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="@dimen/panel_padding">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Versi modul"
                        android:textColor="@color/paper_05"
                        android:textSize="@dimen/text_body" />
                    <TextView
                        android:id="@+id/tvVersion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:textColor="@color/steel_40"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/spacing_lg" />

            <!-- About Dev -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DEVELOPER"
                android:textColor="@color/steel_40"
                android:textSize="11sp"
                android:letterSpacing="0.08"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/graphite_70"
                android:orientation="vertical"
                android:padding="@dimen/panel_padding">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AgusDEV"
                    android:textColor="@color/copper_signal"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telegram: @Machiavellianx"
                    android:textColor="@color/steel_40"
                    android:textSize="@dimen/text_small"
                    android:layout_marginTop="@dimen/spacing_xs" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pure love to making this project."
                    android:textColor="@color/steel_40"
                    android:textSize="@dimen/text_small"
                    android:layout_marginTop="@dimen/spacing_xs"
                    android:textStyle="italic" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
