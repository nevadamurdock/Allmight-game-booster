<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/graphite_90"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <include layout="@layout/toolbar" />

    <!-- Preset tabs -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/spacing_md"
        android:paddingVertical="@dimen/spacing_sm"
        android:background="@color/graphite_70">

        <Button
            android:id="@+id/btnPerformance"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="@string/preset_performance"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="@color/graphite_50"
            android:textColor="@color/paper_05" />

        <Button
            android:id="@+id/btnBalanced"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            android:text="@string/preset_balanced"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="@color/graphite_50"
            android:textColor="@color/paper_05" />

        <Button
            android:id="@+id/btnBatterySaver"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="@string/preset_battery_saver"
            android:textAllCaps="false"
            android:textSize="12sp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:backgroundTint="@color/graphite_50"
            android:textColor="@color/paper_05" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="@dimen/spacing_sm" />
</LinearLayout>
